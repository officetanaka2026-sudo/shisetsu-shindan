# 本番URL（canonical / sitemap / OGP の基準になります）
NEXT_PUBLIC_SITE_URL=https://shisetsu-shindan.jp

# 電話番号（値がある場合のみサイトに表示されます。例: 03-0000-0000 の形式は架空番号のため設定しないでください）
NEXT_PUBLIC_CONTACT_PHONE=

# 公開用メールアドレス（メール設定完了後に設定。空の間は表示されません）
NEXT_PUBLIC_CONTACT_EMAIL=

# Google Analytics 4 の測定ID（例: G-XXXXXXXXXX）
NEXT_PUBLIC_GA_ID=

# 問い合わせメール送信（Resend）
RESEND_API_KEY=
# 問い合わせの通知先（カンマ区切りで複数可）
CONTACT_TO_EMAIL=
# 送信元（Resendで認証済みのドメインのアドレス。例: 施設診断技研 <noreply@shisetsu-shindan.jp>）
CONTACT_FROM_EMAIL=

# --- Feature Flags（true / false） ---
# 料金・概算の表示（falseにすると「条件を確認後お見積り」のみ表示）
NEXT_PUBLIC_PRICING_ENABLED=true
# 法定点検（建築基準法12条点検等）への対応表示。資格者との連携確認が済むまで false
LEGAL_INSPECTION_ENABLED=false
# 使用機体セクションの表示。機体情報を src/config/equipment.ts に入力後 true
EQUIPMENT_SECTION_ENABLED=false
# 導入事例ページ（/cases）の公開。実績を取得後 true
CASES_ENABLED=false
